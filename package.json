{
  "name": "leash",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx tsx --test tests/leash.test.ts",
    "build:program": "anchor build && cp target/idl/leash.json shared/idl/leash.json && cp target/types/leash.ts shared/idl/leash-types.ts",
    "validator": "bash scripts/validator.sh",
    "validator:reset": "bash scripts/validator.sh --reset",
    "setup": "tsx scripts/setup.ts",
    "create-policy": "tsx scripts/create-policy.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "pause": "tsx scripts/pause.ts on",
    "unpause": "tsx scripts/pause.ts off",
    "rotate-agent": "tsx scripts/rotate-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "litesvm": "^0.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
